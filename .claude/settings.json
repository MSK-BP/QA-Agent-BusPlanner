{
  "permissions": {
    "deny": [
      "Read(./**/*Token*.txt)",
      "Read(./**/*Creds*.txt)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pfx)",
      "Read(./**/*.pem)",
      "Read(./**/secrets/**)",
      "Bash(git push:*)",
      "PowerShell(git push:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/tenant-context.ps1"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|mcp__.*(navigate|browser).*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/env-guard.ps1"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/audit-log.ps1"
          }
        ]
      }
    ]
  }
}
